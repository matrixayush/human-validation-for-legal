# Firebase Service Account Credentials Configuration
# Option 1: Absolute or relative path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Option 2: JSON string content (Recommended for Vercel Environment Variables)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}

# Optional: Flask Secret Key
FLASK_SECRET_KEY=legal-human-validation-secret-key-2026
